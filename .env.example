# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-key-here

# ── Strongly recommended ──────────────────────────────────────────────────────
GROQ_API_KEY=your-key-here

# ── Local LLM (llama.cpp server) ──────────────────────────────────────────────
LLM_BASE_URL=http://localhost:8080
LLM_MODEL=qwen2.5-7b-instruct
LLM_CONTEXT=8192

# ── Ollama (optional, for Tier 0 routing) ─────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LOCAL_MODE=false

# ── Paths ─────────────────────────────────────────────────────────────────────
PROJECT_ROOT=C:/Users/micha/jarvis
SKILLS_DIR=C:/Users/micha/jarvis/data/skills
MEMORY_DB=C:/Users/micha/jarvis/memory/jarvis.db
USAGE_LOG=C:/Users/micha/jarvis/data/usage_log.jsonl

# ── Voice ─────────────────────────────────────────────────────────────────────
WAKE_WORD=hey jarvis
TTS_SPEED=1.0
MIC_DEVICE=1
OUTPUT_DEVICE=3

# ── Optional voice enhancement ────────────────────────────────────────────────
ELEVENLABS_API_KEY=your-key-here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ── Finance ───────────────────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your-key-here

# ── Smart home ────────────────────────────────────────────────────────────────
HOMEASSISTANT_TOKEN=your-long-lived-token
HOMEASSISTANT_URL=http://homeassistant.local:8123

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_ADDRESS=your@email.com
EMAIL_PASSWORD=your-app-password

# ── User profile ──────────────────────────────────────────────────────────────
USER_NAME=Michael
USER_LOCATION=Bendigo, Victoria, Australia

# ── Cost management ───────────────────────────────────────────────────────────
DAILY_SPEND_ALERT_AUD=2.00

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_CHANNEL_ID=your-channel-id
